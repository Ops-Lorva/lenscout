{
  "name": "lenscout",
  "version": "0.0.0",
  "description": "Découverte et configuration de caméras IP",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "test:unit": "svelte-kit sync && vitest run",
    "test": "npm run check && npm run test:unit"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "svelte-i18n": "^4.0.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^22",
    "deepmerge": "file:./vendor/deepmerge-4.3.2-lorva.1.tgz",
    "svelte": "^5.57.3",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "deepmerge": "$deepmerge"
  },
  "allowScripts": {
    "esbuild": true,
    "es5-ext": false,
    "fsevents": false
  }
}
